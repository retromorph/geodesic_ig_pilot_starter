# Copy this to .env on the remote host (never commit .env).
# Never paste SSH keys, auth tokens, or gated model credentials into MLflow.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
PROJECT_DATA_DIR=./data
PROJECT_OUTPUT_DIR=./reports
# SSH_TARGET is typically kept on the laptop (not remote) and uses ~/.ssh/config.
# SSH_TARGET=your-authorized-ssh-alias
